---
// Starlight's own 404 page offers only the search bar, and on a phone the header holds nothing
// else, so this replaces it (disable404Route in astro.config.mjs) with the same page plus a way
// back in. The copy is Starlight's; the cards match the landing page's "Keep reading".
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";

export const prerender = true;
---

<StarlightPage
  frontmatter={{
    title: "404",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: { tagline: "Page not found. Check the URL or try using the search bar." },
  }}
>
  <CardGrid>
    <LinkCard
      title="Quickstart"
      href="/quickstart/"
      description="Run the loop yourself in a few minutes."
    />
    <LinkCard
      title="Concepts"
      href="/concepts/"
      description="Sessions, typed events, incarnations, fences, resumability, capabilities."
    />
    <LinkCard
      title="API reference"
      href="/api-reference/"
      description="Generated from the proto: every message, field, and RPC."
    />
  </CardGrid>
</StarlightPage>
