# The image the recorded demo runs in on the remote Linux host (hq remote-test --image): the Go
# toolchain plus every tool up.sh, demo.sh and substrate's kind lane call. It runs with the host's
# network and Docker socket, so kind, its registry on 127.0.0.1:5001 and the instance metadata
# endpoint are all the host's.
FROM golang:1.27
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 zstd jq xz-utils \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:28-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# The versions substrate's hack/tools pin at the commit the adapter's go.mod uses.
RUN GOBIN=/usr/local/bin go install sigs.k8s.io/kind@v0.33.0 \
	&& GOBIN=/usr/local/bin go install github.com/google/ko@v0.19.1 \
	&& rm -rf /root/go /root/.cache
RUN v="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" \
	&& curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${v}/bin/linux/amd64/kubectl" \
	&& chmod 0755 /usr/local/bin/kubectl
