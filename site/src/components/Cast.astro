---
// Embeds an asciinema recording of a real run.
//
// The player is bundled from npm rather than loaded from asciinema.org, so nothing is uploaded and
// the page has no third-party dependency at runtime. The .cast files in public/casts are real
// recordings produced by the scripts in hack/demos, not hand-written transcripts.
//
// The recording loops, so the chrome bar carries the same pause button as the other figures; the
// player's own controls only appear on hover. Under reduced motion it does not autoplay and shows
// the poster frame until someone presses play.
import MotionToggle from "./MotionToggle.astro";

interface Props {
  src: string;
  title: string;
  caption?: string;
  poster?: string;
  idle?: number;
}
const { src, title, caption, poster = "npt:0:04", idle = 1.5 } = Astro.props;
const id = `cast-${src.replace(/\W+/g, "-")}`;
---

<figure class="cast panel">
  <div class="panel__bar">
    <MotionToggle label="Pause the recording" />
    <span class="panel__label">{title}</span>
    <span class="panel__note cast__badge">recorded</span>
  </div>
  <div
    class="cast__player"
    id={id}
    data-cast
    data-src={src}
    data-poster={poster}
    data-idle={String(idle)}
  >
  </div>
  {caption && <figcaption class="panel__caption" set:html={caption} />}
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";
  import { prefersReducedMotion } from "../scripts/motion";

  for (const el of document.querySelectorAll<HTMLElement>("[data-cast]")) {
    const src = el.dataset.src!;
    const button = el.closest(".cast")?.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    type Player = ReturnType<typeof AsciinemaPlayer.create>;
    let player: Player | undefined;
    // "Paused" is the user's intent until the player exists, then the player's own state.
    let paused = prefersReducedMotion();

    const reflect = (p: boolean) => {
      paused = p;
      button?.setAttribute("aria-pressed", String(p));
    };

    if (button) {
      button.hidden = false;
      reflect(paused);
      button.addEventListener("click", () => {
        if (!player) return reflect(!paused);
        if (paused) player.play();
        else player.pause();
      });
    }

    // At its natural 13px the terminal is about 800px wide, wider than the panel below 60rem, where
    // it was cut off on both sides. There it scales to the panel instead; the player's fullscreen
    // control gives a readable size on a phone. The player takes its fit mode only at creation, so
    // when the query flips after that (a tablet rotating, the page zoomed) it is rebuilt.
    const narrowQuery = window.matchMedia("(max-width: 60rem)");
    let fitted = false;

    // `at` is where a rebuilt player picks up: playing from there, or held on that frame. The
    // player draws no frame for a paused startAt, so a held one uses it as the poster instead.
    const mount = (at?: number) => {
      const narrow = narrowQuery.matches;
      fitted = narrow;
      el.classList.toggle("cast__player--fit", narrow);
      const position =
        at === undefined
          ? { poster: el.dataset.poster }
          : paused
            ? { poster: `npt:${at}` }
            : { startAt: at };
      const p = AsciinemaPlayer.create(src, el, {
        autoPlay: !paused,
        loop: true,
        // Long pauses are real (a rollout takes time) but boring to watch, so cap them.
        idleTimeLimit: Number(el.dataset.idle),
        ...position,
        fit: narrow ? "width" : false,
        terminalFontSize: "13px",
        theme: "asciinema",
      });
      // Disposing a player stops it, which must not read as the user pausing it.
      p.addEventListener("playing", () => p === player && reflect(false));
      p.addEventListener("pause", () => p === player && reflect(true));
      p.addEventListener("ended", () => p === player && reflect(true));
      player = p;
    };

    const refit = () => {
      if (!player || narrowQuery.matches === fitted) return;
      // Entering fullscreen from a narrow window widens it past 60rem; rebuilding then would remove
      // the fullscreen element and throw the reader out. Wait until they leave fullscreen.
      const full =
        document.fullscreenElement ??
        (document as Document & { webkitFullscreenElement?: Element }).webkitFullscreenElement;
      if (full && el.contains(full)) return;
      const old = player;
      // Before the recording has loaded there is no position to keep; show the poster again.
      const at = old.getCurrentTime();
      player = undefined;
      old.dispose();
      mount(Number.isFinite(at) && at > 0 ? at : undefined);
    };
    narrowQuery.addEventListener("change", refit);
    document.addEventListener("fullscreenchange", refit);
    document.addEventListener("webkitfullscreenchange", refit);

    // Autoplay only once the recording scrolls into view, and only then create the player, so a
    // page with several recordings does not start them all at load.
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          mount();
          obs.unobserve(entry.target);
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(el);
  }
</script>

<style is:global>
  .cast__badge {
    color: var(--p-good);
    border: 1px solid rgb(63 185 80 / 0.35);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
  }

  /* The player ships its own surface colour, which drew a visible lighter rectangle inside the
     panel. Make it transparent so the recording sits on the same background as everything else. */
  .cast .ap-player,
  .cast .ap-terminal {
    background: transparent;
    border: 0;
    font-feature-settings: normal;
  }

  /* The player reserves its own height once it initialises; this only covers the pre-init gap. */
  .cast__player {
    min-height: 12rem;
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  /* fit: "width" sizes the player from its container's width, which a centring flex row would
     shrink to nothing, so a fitted player sits in a plain block. */
  .cast__player--fit {
    display: block;
  }
</style>
