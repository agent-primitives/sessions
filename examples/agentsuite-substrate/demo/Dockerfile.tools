# The image the recorded demo runs in on the remote Linux host (hq remote-test --image): the Go
# toolchain plus every tool up.sh, demo.sh and substrate's kind lane call, and bat, which driver.sh
# show uses to print files syntax-highlighted (Debian installs it as batcat). It runs with the host's
# network and Docker socket, so kind, its registry on 127.0.0.1:5001 and the instance metadata
# endpoint are all the host's.
FROM golang:1.27.3
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 zstd jq xz-utils bat \
	&& ln -s /usr/bin/batcat /usr/local/bin/bat \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:28-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# The versions substrate's hack/tools pin at the commit the adapter's go.mod uses.
RUN GOBIN=/usr/local/bin go install sigs.k8s.io/kind@v0.33.0 \
	&& GOBIN=/usr/local/bin go install github.com/google/ko@v0.19.1 \
	&& rm -rf /root/go /root/.cache
# The client at the kind node image's Kubernetes version, checked against its published sha256.
ARG KUBECTL_VERSION=v1.37.0
ARG KUBECTL_SHA256=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f
RUN curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
	&& echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - \
	&& chmod 0755 /usr/local/bin/kubectl
